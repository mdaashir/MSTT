# Copy to .env and adjust as needed. Every value here has a typed default in
# src/config.ts, so the API runs without a .env file at all.
PORT=3000
# SQLite file. Relative paths resolve against the backend package root.
DATABASE_PATH=data/tickets.db
# Origin allowed by CORS. The Vite dev server defaults to 5173.
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
