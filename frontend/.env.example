# Copy to .env.local (git-ignored) and adjust. Every value has a default, so the
# dev server runs with no .env file at all.

# Where the UI proxies /api in development.
API_PROXY_TARGET=http://localhost:3000

# Absolute origin used for canonical, Open Graph and sitemap URLs. These are
# required to be absolute, so set this to the real deployment origin before
# building for production. Leave it unset for local development.
#
#   VITE_SITE_URL=https://tickets.example.com
VITE_SITE_URL=
